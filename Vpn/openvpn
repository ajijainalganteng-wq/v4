
#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
OS=`uname -m`;
MYIP=$(wget -qO- ipinfo.io/ip);
domain=$(cat /root/domain)
MYIP2="s/xxxxxxxxx/$domain/g";

function ovpn_install() {
apt-get update -y
apt-get install -y openvpn unzip zip iptables-persistent

if [[ -z "$domain" ]]; then
echo "ERROR: Domain tidak ditemukan di /root/domain"
exit 1
fi

rm -rf /etc/openvpn
mkdir -p /etc/openvpn

wget -qO /etc/openvpn/vpn.zip "https://raw.githubusercontent.com/arivpnstores/v4/main/Vpn/vpn.zip"

if [[ ! -s /etc/openvpn/vpn.zip ]]; then
echo "ERROR: Gagal mengunduh file vpn.zip"
exit 1
fi

unzip -oq /etc/openvpn/vpn.zip -d /etc/openvpn/
rm -f /etc/openvpn/vpn.zip

if [[ ! -d /etc/openvpn/server/easy-rsa/ ]]; then
echo "ERROR: Direktori Easy-RSA tidak ditemukan"
exit 1
fi

chown -R root:root /etc/openvpn/server/easy-rsa/

if [[ ! -f /etc/openvpn/server/server-tcp.conf || ! -f /etc/openvpn/server/server-udp.conf ]]; then
echo "ERROR: Konfigurasi server-tcp.conf atau server-udp.conf tidak ditemukan"
exit 1
fi
}

function config_easy() {
cd

mkdir -p /usr/lib/openvpn/

# Mendeteksi lokasi plugin PAM sesuai arsitektur VPS
PAM_PLUGIN=$(find /usr/lib -type f -name openvpn-plugin-auth-pam.so -print -quit)

if [[ -n "$PAM_PLUGIN" ]]; then
cp "$PAM_PLUGIN" /usr/lib/openvpn/openvpn-plugin-auth-pam.so
else
echo "PERINGATAN: Plugin OpenVPN PAM tidak ditemukan"
fi

sed -i 's/#AUTOSTART="all"/AUTOSTART="all"/g' /etc/default/openvpn

# Mengaktifkan service OpenVPN TCP dan UDP
systemctl daemon-reload
systemctl enable --now openvpn-server@server-tcp
systemctl enable --now openvpn-server@server-udp

# Memastikan kedua service berjalan
systemctl is-active --quiet openvpn-server@server-tcp || {
echo "ERROR: OpenVPN TCP gagal dijalankan"
systemctl status openvpn-server@server-tcp --no-pager
exit 1
}

systemctl is-active --quiet openvpn-server@server-udp || {
echo "ERROR: OpenVPN UDP gagal dijalankan"
systemctl status openvpn-server@server-udp --no-pager
exit 1
}
}

function make_follow() {
# Mengaktifkan IP Forwarding
sysctl -w net.ipv4.ip_forward=1

cat > /etc/sysctl.d/99-openvpn-ip-forward.conf <<EOF
net.ipv4.ip_forward=1
EOF

sysctl --system >/dev/null 2>&1

# Membuat konfigurasi OpenVPN TCP
cat > /etc/openvpn/tcp.ovpn <<-END
client
dev tun
proto tcp
remote xxxxxxxxx 1194
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
auth-nocache
remote-cert-tls server
verb 3
END
sed -i $MYIP2 /etc/openvpn/tcp.ovpn;

# Membuat konfigurasi OpenVPN UDP
cat > /etc/openvpn/udp.ovpn <<-END
client
dev tun
proto udp
remote xxxxxxxxx 2200
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
auth-nocache
remote-cert-tls server
verb 3
END
sed -i $MYIP2 /etc/openvpn/udp.ovpn;

# Membuat konfigurasi OpenVPN WS-SSL
cat > /etc/openvpn/ws-ssl.ovpn <<-END
client
dev tun
proto tcp
remote xxxxxxxxx 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
auth-nocache
remote-cert-tls server
verb 3
END
sed -i $MYIP2 /etc/openvpn/ws-ssl.ovpn;

# Membuat konfigurasi OpenVPN SSL
cat > /etc/openvpn/ssl.ovpn <<-END
client
dev tun
proto tcp
remote xxxxxxxxx 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
auth-nocache
remote-cert-tls server
verb 3
END
sed -i $MYIP2 /etc/openvpn/ssl.ovpn;
}

function cert_ovpn() {
# Memastikan sertifikat CA tersedia
if [[ ! -s /etc/openvpn/server/ca.crt ]]; then
echo "ERROR: Sertifikat CA tidak ditemukan"
exit 1
fi

mkdir -p /var/www/html/

# Sertifikat OpenVPN TCP
echo '<ca>' > /etc/openvpn/tcp.ovpn
cat /etc/openvpn/server/ca.crt >> /etc/openvpn/tcp.ovpn
echo '</ca>' >> /etc/openvpn/tcp.ovpn
cp /etc/openvpn/tcp.ovpn /var/www/html/tcp.ovpn

# Sertifikat OpenVPN UDP
echo '<ca>' > /etc/openvpn/udp.ovpn
cat /etc/openvpn/server/ca.crt >> /etc/openvpn/udp.ovpn
echo '</ca>' >> /etc/openvpn/udp.ovpn
cp /etc/openvpn/udp.ovpn /var/www/html/udp.ovpn

# Sertifikat OpenVPN WS-SSL
echo '<ca>' > /etc/openvpn/ws-ssl.ovpn
cat /etc/openvpn/server/ca.crt >> /etc/openvpn/ws-ssl.ovpn
echo '</ca>' >> /etc/openvpn/ws-ssl.ovpn
cp /etc/openvpn/ws-ssl.ovpn /var/www/html/ws-ssl.ovpn

# Sertifikat OpenVPN SSL
echo '<ca>' > /etc/openvpn/ssl.ovpn
cat /etc/openvpn/server/ca.crt >> /etc/openvpn/ssl.ovpn
echo '</ca>' >> /etc/openvpn/ssl.ovpn
cp /etc/openvpn/ssl.ovpn /var/www/html/ssl.ovpn

cd /var/www/html/

# Membuat ulang file ZIP konfigurasi VPN
rm -f Kyt-Project.zip
zip -q Kyt-Project.zip tcp.ovpn udp.ovpn ssl.ovpn ws-ssl.ovpn

cd

# Firewall untuk memperbolehkan akses UDP dan TCP
# Mendeteksi interface jaringan otomatis jika ANU belum tersedia
ANU=${ANU:-$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')}

if [[ -z "$ANU" ]]; then
echo "ERROR: Interface jaringan tidak ditemukan"
exit 1
fi

# NAT OpenVPN TCP
iptables -t nat -C POSTROUTING -s 10.6.0.0/24 -o "$ANU" -j MASQUERADE 2>/dev/null || \
iptables -t nat -I POSTROUTING -s 10.6.0.0/24 -o "$ANU" -j MASQUERADE

# NAT OpenVPN UDP
iptables -t nat -C POSTROUTING -s 10.7.0.0/24 -o "$ANU" -j MASQUERADE 2>/dev/null || \
iptables -t nat -I POSTROUTING -s 10.7.0.0/24 -o "$ANU" -j MASQUERADE

# Menyimpan konfigurasi firewall
iptables-save > /etc/iptables.up.rules

# Memeriksa konfigurasi firewall
iptables-restore --test < /etc/iptables.up.rules || {
echo "ERROR: Konfigurasi iptables tidak valid"
exit 1
}

netfilter-persistent save
netfilter-persistent reload

# Memastikan service OpenVPN aktif
systemctl enable --now openvpn-server@server-tcp
systemctl enable --now openvpn-server@server-udp

# Delete script
}

function install_ovpn() {
ovpn_install
config_easy
make_follow
cert_ovpn
systemctl enable openvpn-server@server-tcp
systemctl enable openvpn-server@server-udp
}

install_ovpn
