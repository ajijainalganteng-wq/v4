restart_system() {
domainNOTIF=$(cat /etc/xray/domain)
USRSC=$(cat /usr/bin/user)
EXPSC=$(cat /usr/bin/e)
TIMEZONE=$(printf '%(%H:%M:%S)T')
TEXT="
<code>────────────────────</code>
<b> 🟢 NOTIFICATIONS INSTALL 🟢</b>
<code>────────────────────</code>
<code>ID     : </code><code>$USRSC</code>
<code>Domain : </code><code>$domainNOTIF</code>
<code>Date   : </code><code>$TIME</code>
<code>Time   : </code><code>$TIMEZONE</code>
<code>Ip vps : </code><code>$ipsaya</code>
<code>Exp Sc : </code><code>$EXPSC</code>
<code>────────────────────</code>
<i>Automatic Notification from Github</i>
"'&reply_markup={"inline_keyboard":[[{"text":"ᴏʀᴅᴇʀ","url":"https://wa.me/AJIVPN"},{"text":"Contact","url":"https://wa.me/6287862591220"}]]}'
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -fsS --max-time "$TIMES" -X POST "$URL" \
        --data-urlencode "chat_id=$CHATID" \
        --data-urlencode "disable_web_page_preview=true" \
        --data-urlencode "text=$TEXT" -d "parse_mode=HTML" >/dev/null || true
fi
}
auto_system() {
    cron_file="/etc/cron.d/auto_update"
    pekerjaan_cron="15 1 * * * root /usr/bin/auto_update"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
        chmod 644 "$cron_file"
    fi
# Fungsi untuk menambahkan pekerjaan cron ke /etc/cron.d/
    cron_file="/etc/cron.d/backup_otomatis"
    pekerjaan_cron="15 23 * * * root /usr/bin/backupfile"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
        chmod 644 "$cron_file"
    fi
}

clear
function pasang_ssl() {
# ==============================
# 6️⃣ Input Domain Manual
# ==============================
while true; do
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    read -rp "Masukkan Domain VPS: " DOMAIN
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ -n "$DOMAIN" ]]; then
        echo "$DOMAIN" > /root/domain
        mkdir -p /etc/xray
        echo "$DOMAIN" > /etc/xray/domain
        echo ""
        echo "Domain berhasil disimpan: $DOMAIN"
        sleep 2
        break
    else
        echo "Domain tidak boleh kosong, silakan masukkan kembali."
    fi
done
clear
print_install "Memasang SSL Pada Domain"
rm -rf /etc/xray/xray.key
rm -rf /etc/xray/xray.crt
domain=$(cat /root/domain)
STOPWEBSERVER=$(lsof -i:80 | cut -d' ' -f1 | awk 'NR==2 {print $1}')
rm -rf /root/.acme.sh
mkdir /root/.acme.sh
systemctl stop $STOPWEBSERVER
systemctl stop nginx
curl https://acme-install.netlify.app/acme.sh -o /root/.acme.sh/acme.sh
chmod +x /root/.acme.sh/acme.sh
/root/.acme.sh/acme.sh --upgrade --auto-upgrade
/root/.acme.sh/acme.sh --set-default-ca --server letsencrypt
/root/.acme.sh/acme.sh --issue -d $domain --standalone -k ec-256
~/.acme.sh/acme.sh --installcert -d $domain --fullchainpath /etc/xray/xray.crt --keypath /etc/xray/xray.key --ecc
chmod 777 /etc/xray/xray.key
print_success "SSL Certificate"
}
function make_folder_xray() {
mkdir -p /etc/bot
mkdir -p /etc/xray
mkdir -p /etc/vmess
mkdir -p /etc/vless
mkdir -p /etc/trojan
mkdir -p /etc/shadowsocks
mkdir -p /etc/ssh
mkdir -p /usr/bin/xray/
mkdir -p /var/log/xray/
mkdir -p /var/www/html
mkdir -p /etc/kyt/limit/vmess/ip
mkdir -p /etc/kyt/limit/vless/ip
mkdir -p /etc/kyt/limit/trojan/ip
mkdir -p /etc/kyt/limit/ssh/ip
mkdir -p /etc/limit/vmess
mkdir -p /etc/limit/vless
mkdir -p /etc/limit/trojan
mkdir -p /etc/limit/ssh
chmod 755 /var/log/xray
touch /var/log/xray/access.log
touch /var/log/xray/error.log
touch /etc/vmess/.vmess.db
touch /etc/vless/.vless.db
touch /etc/trojan/.trojan.db
touch /etc/shadowsocks/.shadowsocks.db
touch /etc/ssh/.ssh.db
touch /etc/bot/.bot.db
for db in /etc/vmess/.vmess.db /etc/vless/.vless.db /etc/trojan/.trojan.db /etc/shadowsocks/.shadowsocks.db /etc/ssh/.ssh.db; do
    if [[ ! -s "$db" ]]; then printf '%s\n' "& plughin Account" > "$db"; fi
done
}
function install_xray() {
    clear
    print_install "Memasang Xray Core stabil terbaru"
    local domain domain_escaped tmp_cfg
    domain=$(tr -d '\r\n' < /etc/xray/domain)
    [[ -n "$domain" ]] || { print_error "Domain /etc/xray/domain kosong"; return 1; }
    install -d -o www-data -g www-data -m 0750 /run/xray

    # Gunakan installer resmi XTLS dan gagal cepat bila unduhan tidak valid.
    curl -fsSL --retry 3 --retry-delay 2 https://github.com/XTLS/Xray-install/raw/main/install-release.sh -o /tmp/xray-install-release.sh || return 1
    bash /tmp/xray-install-release.sh install -u www-data || return 1
    command -v xray >/dev/null 2>&1 || { print_error "Binary Xray tidak ditemukan setelah instalasi"; return 1; }

    install -d -m 0750 /etc/xray /etc/haproxy /etc/nginx/conf.d
    tmp_cfg=$(mktemp)
    curl -fsSL --retry 3 "${REPO}Cfg/config.json" -o "$tmp_cfg" || { rm -f "$tmp_cfg"; return 1; }
    jq -e . "$tmp_cfg" >/dev/null || { rm -f "$tmp_cfg"; print_error "config.json dari repo bukan JSON valid"; return 1; }
    install -o root -g www-data -m 0640 "$tmp_cfg" /etc/xray/config.json
    rm -f "$tmp_cfg"

    curl -fsSL --retry 3 "${REPO}Fls/runn.service" -o /etc/systemd/system/runn.service || return 1
    chmod 644 /etc/systemd/system/runn.service

    print_ok "Mengambil konfigurasi HAProxy dan Nginx dari repo yang sama"
    local hap_tmp nginx_tmp nginx_main_tmp
    hap_tmp=$(mktemp); nginx_tmp=$(mktemp); nginx_main_tmp=$(mktemp)
    curl -fsSL --retry 3 "${REPO}Cfg/haproxy.cfg" -o "$hap_tmp" || { rm -f "$hap_tmp" "$nginx_tmp" "$nginx_main_tmp"; return 1; }
    curl -fsSL --retry 3 "${REPO}Cfg/xray.conf" -o "$nginx_tmp" || { rm -f "$hap_tmp" "$nginx_tmp" "$nginx_main_tmp"; return 1; }
    curl -fsSL --retry 3 "${REPO}Cfg/nginx.conf" -o "$nginx_main_tmp" || { rm -f "$hap_tmp" "$nginx_tmp" "$nginx_main_tmp"; return 1; }

    # Compatibility corrections to the downloaded HAProxy config only; remote repo is untouched.
    sed -i -E 's/^[[:space:]]*bind-process[[:space:]]+1[[:space:]]+2[[:space:]]*$/    bind-process 1/' "$hap_tmp"
    awk '!seen[$0]++ || $0 !~ /^[[:space:]]*bind \*:2095([[:space:]]|$)/' "$hap_tmp" > "${hap_tmp}.dedup" && mv "${hap_tmp}.dedup" "$hap_tmp"
    domain_escaped="$domain"
    sed -i "s|xxx|$domain_escaped|g" "$nginx_tmp" "$nginx_main_tmp"
    sed -i -E 's/TLSv1\.1[[:space:]]+TLSv1\.2[[:space:]]+TLSv1\.3/TLSv1.2 TLSv1.3/g' "$nginx_tmp"
    sed -i "s|xxx|$domain_escaped|g" "$hap_tmp"

    # TLS private key must never be world-readable.
    cat /etc/xray/xray.crt /etc/xray/xray.key > /etc/haproxy/hap.pem || { rm -f "$hap_tmp" "$nginx_tmp" "$nginx_main_tmp"; return 1; }
    chown root:haproxy /etc/haproxy/hap.pem
    chmod 640 /etc/haproxy/hap.pem

    # Back up existing local configs before replacing them.
    [[ -f /etc/haproxy/haproxy.cfg ]] && cp -a /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak
    [[ -f /etc/nginx/nginx.conf ]] && cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak
    [[ -f /etc/nginx/conf.d/xray.conf ]] && cp -a /etc/nginx/conf.d/xray.conf /etc/nginx/conf.d/xray.conf.bak
    install -m 644 "$hap_tmp" /etc/haproxy/haproxy.cfg
    install -m 644 "$nginx_tmp" /etc/nginx/conf.d/xray.conf
    install -m 644 "$nginx_main_tmp" /etc/nginx/nginx.conf
    rm -f "$hap_tmp" "$nginx_tmp" "$nginx_main_tmp"

    # Validate before activating services. Restore prior config on failure.
    if ! haproxy -c -f /etc/haproxy/haproxy.cfg; then
        [[ -f /etc/haproxy/haproxy.cfg.bak ]] && cp -af /etc/haproxy/haproxy.cfg.bak /etc/haproxy/haproxy.cfg
        print_error "Validasi konfigurasi HAProxy gagal; konfigurasi lama dipulihkan bila tersedia"
        return 1
    fi
    if ! nginx -t; then
        [[ -f /etc/nginx/nginx.conf.bak ]] && cp -af /etc/nginx/nginx.conf.bak /etc/nginx/nginx.conf
        [[ -f /etc/nginx/conf.d/xray.conf.bak ]] && cp -af /etc/nginx/conf.d/xray.conf.bak /etc/nginx/conf.d/xray.conf
        print_error "Validasi konfigurasi Nginx gagal; konfigurasi lama dipulihkan bila tersedia"
        return 1
    fi

    cat >/etc/systemd/system/xray.service <<'EOF'
[Unit]
Description=Xray Service
Documentation=https://github.com/XTLS/Xray-core
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
Type=simple
User=www-data
Group=www-data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/xray run -config /etc/xray/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
LimitNPROC=10000
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
    if ! /usr/local/bin/xray run -test -config /etc/xray/config.json; then
        print_error "Konfigurasi Xray gagal divalidasi; periksa /etc/xray/config.json"
        return 1
    fi
    systemctl daemon-reload
    systemctl enable xray haproxy nginx
    systemctl restart xray haproxy nginx
    print_ok "Xray: $(xray version 2>/dev/null | head -n1)"
    print_success "Xray, HAProxy, dan Nginx"
}

