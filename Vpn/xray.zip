function profile(){
clear
cat <<EOF > /root/.profile
if [ "/bin/bash" ]; then
  if [ -f ~/.bashrc ]; then
    . ~/.bashrc
  fi
fi
mesg n || true
welcome
EOF
cat >/etc/cron.d/log_clear <<-END
		8 0 * * * root /usr/local/bin/log_clear
	END

cat >/usr/local/bin/log_clear <<-END
#!/bin/bash
tanggal=$(date +"%m-%d-%Y")
waktu=$(date +"%T")
echo "Sucsesfully clear & restart On $tanggal Time $waktu." >> /root/log-clear.txt
systemctl restart udp-custom.service
END
	chmod +x /usr/local/bin/log_clear
	
cat >/etc/cron.d/daily_backup <<-END
		0 22 * * * root /usr/local/bin/daily_backup
	END

cat >/usr/local/bin/daily_backup <<-END
#!/bin/bash
tanggal=$(date +"%m-%d-%Y")
waktu=$(date +"%T")
echo "Sucsesfully Backup On $tanggal Time $waktu." >> /root/log-backup.txt
/usr/bin/backup -r now
END
	chmod +x /usr/local/bin/daily_backup

cat >/etc/cron.d/xp_sc <<-END
		5 0 * * * root /usr/local/bin/xp_sc
	END

cat >/usr/local/bin/xp_sc <<-'END'
#!/bin/bash
# Auto delete akun expired - reliable version
TODAY=$(date +%Y-%m-%d)

# Delete expired vmess
if [ -f /etc/vmess/.vmess.db ]; then
  while read line; do
    user=$(echo "$line" | awk '{print $2}')
    exp=$(echo "$line" | awk '{print $3}')
    [ -z "$user" ] && continue
    [ -z "$exp" ] && continue
    [[ "$line" == *"plughin"* ]] && continue
    if [[ "$exp" < "$TODAY" || "$exp" == "$TODAY" ]]; then
      sed -i "/^### $user /d" /etc/vmess/.vmess.db
      sed -i "/^#vm# $user /d" /etc/vmess/.vmess.db
      sed -i "/#& $user/d" /etc/xray/config.json 2>/dev/null
      echo "Deleted vmess: $user (exp: $exp)" >> /var/log/xray/xp-delete.log
    fi
  done < <(grep "^### " /etc/vmess/.vmess.db)
fi

# Delete expired vless
if [ -f /etc/vless/.vless.db ]; then
  while read line; do
    user=$(echo "$line" | awk '{print $2}')
    exp=$(echo "$line" | awk '{print $3}')
    [ -z "$user" ] && continue
    [ -z "$exp" ] && continue
    [[ "$line" == *"plughin"* ]] && continue
    if [[ "$exp" < "$TODAY" || "$exp" == "$TODAY" ]]; then
      sed -i "/^### $user /d" /etc/vless/.vless.db
      sed -i "/^#vl# $user /d" /etc/vless/.vless.db
      sed -i "/#& $user/d" /etc/xray/config.json 2>/dev/null
      echo "Deleted vless: $user (exp: $exp)" >> /var/log/xray/xp-delete.log
    fi
  done < <(grep "^### " /etc/vless/.vless.db)
fi

# Delete expired trojan
if [ -f /etc/trojan/.trojan.db ]; then
  while read line; do
    user=$(echo "$line" | awk '{print $2}')
    exp=$(echo "$line" | awk '{print $3}')
    [ -z "$user" ] && continue
    [ -z "$exp" ] && continue
    [[ "$line" == *"plughin"* ]] && continue
    if [[ "$exp" < "$TODAY" || "$exp" == "$TODAY" ]]; then
      sed -i "/^### $user /d" /etc/trojan/.trojan.db
      sed -i "/^#tr# $user /d" /etc/trojan/.trojan.db
      sed -i "/#& $user/d" /etc/xray/config.json 2>/dev/null
      echo "Deleted trojan: $user (exp: $exp)" >> /var/log/xray/xp-delete.log
    fi
  done < <(grep "^### " /etc/trojan/.trojan.db)
fi

# Delete expired ssh
if [ -f /etc/ssh/.ssh.db ]; then
  while read line; do
    user=$(echo "$line" | awk '{print $2}')
    exp=$(echo "$line" | awk '{print $3}')
    [ -z "$user" ] && continue
    [ -z "$exp" ] && continue
    [[ "$line" == *"plughin"* ]] && continue
    if [[ "$exp" < "$TODAY" || "$exp" == "$TODAY" ]]; then
      userdel -f "$user" 2>/dev/null
      sed -i "/^### $user /d" /etc/ssh/.ssh.db
      sed -i "/^#ssh# $user /d" /etc/ssh/.ssh.db
      echo "Deleted ssh: $user (exp: $exp)" >> /var/log/xray/xp-delete.log
    fi
  done < <(grep "^### " /etc/ssh/.ssh.db)
fi

# Restart xray setelah hapus akun
systemctl restart xray 2>/dev/null
echo "$(date '+%Y-%m-%d %H:%M:%S') - Auto delete selesai" >> /var/log/xray/xp-delete.log
END
	chmod +x /usr/local/bin/xp_sc

# === CRON AUTO REFRESH IZIN (tiap 6 jam) ===
cat >/usr/local/bin/auto_izin <<-'END'
#!/bin/bash
IZIN_URL="https://raw.githubusercontent.com/ajijainalganteng-wq/izin/main/ip"
IPSAVE_FILE="/usr/bin/ipsave"
USER_FILE="/usr/bin/user"
EXP_FILE="/usr/bin/e"

MYIP=$(curl -s --max-time 5 ipv4.icanhazip.com || curl -s --max-time 5 ifconfig.me)
[ -z "$MYIP" ] && exit 1
echo "$MYIP" > "$IPSAVE_FILE"

IPLIST=$(curl -s --max-time 8 "$IZIN_URL")
[ -z "$IPLIST" ] && exit 1

DATA=$(echo "$IPLIST" | grep -w "$MYIP")
[ -z "$DATA" ] && exit 1

echo "$DATA" | awk '{print $2}' > "$USER_FILE"
echo "$DATA" | awk '{print $3}' > "$EXP_FILE"

# Update city & ISP
city="$(curl -fsS --max-time 5 ipinfo.io/city 2>/dev/null | tr -d '\r')"
[ -n "$city" ] && echo "$city" > /etc/xray/city
isp="$(curl -fsS --max-time 5 ipinfo.io/org 2>/dev/null | tr -d '\r' | cut -d' ' -f2-)"
[ -n "$isp" ] && echo "$isp" > /etc/xray/isp
END
chmod +x /usr/local/bin/auto_izin

cat >/etc/cron.d/auto_izin <<-END
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 */6 * * * root /usr/local/bin/auto_izin
END
# Fungsi untuk menambahkan pekerjaan cron ke /etc/cron.d/
    cron_file="/etc/cron.d/auto_update"
    pekerjaan_cron="15 1 * * * root /usr/bin/auto_update"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
    fi

# Fungsi untuk menambahkan pekerjaan cron ke /etc/cron.d/
    cron_file="/etc/cron.d/auto_update2"
    pekerjaan_cron="15 2 * * * root /usr/bin/auto_update2"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
    fi

# Fungsi untuk menambahkan pekerjaan cron ke /etc/cron.d/
    cron_file="/etc/cron.d/backup_otomatis"
    pekerjaan_cron="15 23 * * * root /usr/bin/backupfile"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
    fi

# Fungsi untuk menambahkan pekerjaan cron ke /etc/cron.d/
    cron_file="/etc/cron.d/delete_exp"
    pekerjaan_cron="15 0 * * * root /usr/local/bin/xp_sc"

    # Periksa apakah pekerjaan cron sudah ada di file
    if ! grep -Fq "$pekerjaan_cron" "$cron_file" 2>/dev/null; then
        echo "$pekerjaan_cron" > "$cron_file"
    fi
cat >/etc/cron.d/logclean <<-END
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
*/10 * * * * root /usr/bin/clearlog
END
chmod 644 /root/.profile
cat >/etc/cron.d/daily_reboot <<-END
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
5 0 * * * root /sbin/reboot
END
echo "*/1 * * * * root echo -n > /var/log/nginx/access.log" >/etc/cron.d/log.nginx
echo "*/1 * * * * root echo -n > /var/log/xray/access.log" >>/etc/cron.d/log.xray
service cron restart
cat >/home/daily_reboot <<-END
5
END
cat > /etc/systemd/system/rc-local.service <<'EOF'
[Unit]
Description=/etc/rc.local Compatibility
ConditionFileIsExecutable=/etc/rc.local
After=network.target

[Service]
Type=oneshot
ExecStart=/etc/rc.local start
TimeoutStartSec=0
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
echo "/bin/false" >>/etc/shells
echo "/usr/sbin/nologin" >>/etc/shells

cat > /etc/rc.local <<'EOF'
#!/bin/bash

# Pastikan iptables tersedia
IPTABLES="/usr/sbin/iptables"

if ! command -v iptables >/dev/null 2>&1; then
    echo "ERROR: iptables tidak ditemukan."
    exit 1
fi

IPTABLES=$(command -v iptables)

# Izinkan UDP port 5300
$IPTABLES -C INPUT -p udp --dport 5300 -j ACCEPT 2>/dev/null ||
$IPTABLES -I INPUT -p udp --dport 5300 -j ACCEPT

# Redirect DNS UDP port 53 ke port 5300
$IPTABLES -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null ||
$IPTABLES -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300

exit 0
EOF

chmod 755 /etc/rc.local

AUTOREB=$(cat /home/daily_reboot 2>/dev/null)
SETT=11

if [[ "$AUTOREB" =~ ^[0-9]+$ ]] && [ "$AUTOREB" -gt "$SETT" ]; then
    TIME_DATE="PM"
else
    TIME_DATE="AM"
fi

print_success "Menu Packet"
}
function enable_services(){
clear
print_install "Enable Service"
systemctl daemon-reload
systemctl start netfilter-persistent
systemctl enable --now rc-local
systemctl enable --now cron
systemctl enable --now netfilter-persistent
systemctl enable xray
systemctl restart nginx
systemctl restart xray
systemctl restart cron
systemctl restart haproxy
# Verifikasi xray jalan
sleep 2
if systemctl is-active --quiet xray; then
    echo -e "${Green}Xray: RUNNING${FONT}"
else
    echo -e "${RED}Xray: FAILED - cek: journalctl -u xray${FONT}"
fi
print_success "Enable Service"
clear
}
