clear
# nginx renew ssl
echo -n '#!/bin/bash
systemctl stop nginx
"/root/.acme.sh"/acme.sh --cron --home "/root/.acme.sh" &> /root/renew_ssl.log
systemctl start nginx
systemctl status nginx --no-pager
' > /usr/local/bin/ssl_renew.sh
