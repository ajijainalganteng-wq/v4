function ins_vnstat() {
    clear
    print_install "Menginstall vnStat dari repository distro"
    apt-get update
    apt-get install -y vnstat
    local net_interface
    net_interface=$(ip -o -4 route show to default | awk '{print $5; exit}')
    if [[ -n "$net_interface" ]]; then
        vnstat --add -i "$net_interface" 2>/dev/null || true
    fi
    systemctl enable --now vnstat
    print_success "vnStat"
}

