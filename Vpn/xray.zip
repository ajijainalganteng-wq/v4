#!/bin/bash
Green="\e[92;1m"
RED="\033[1;31m"
YELLOW="\033[33m"
BLUE="\033[36m"
FONT="\033[0m"
GREENBG="\033[42;37m"
REDBG="\033[41;37m"
OK="${Green}--->${FONT}"
ERROR="${RED}[ERROR]${FONT}"
GRAY="\e[1;30m"
NC='\e[0m'
red='\e[1;31m'
green='\e[0;32m'
TIME=$(date '+%d %b %Y')
TIMES="10"
CHATID="${TELEGRAM_CHAT_ID:-}"
KEY="${TELEGRAM_BOT_TOKEN:-}"
URL="https://api.telegram.org/bot${KEY}/sendMessage"
function print_ok() {
echo -e "${OK} ${BLUE} $1 ${FONT}"
}
function print_install() {
echo -e "${green} =============================== ${FONT}"
echo -e "${YELLOW} # $1 ${FONT}"
echo -e "${green} =============================== ${FONT}"
sleep 1
}
function print_error() {
echo -e "${ERROR} ${REDBG} $1 ${FONT}"
}
function print_success() {
if [[ 0 -eq $? ]]; then
echo -e "${green} =============================== ${FONT}"
echo -e "${Green} # $1 berhasil dipasang"
echo -e "${green} =============================== ${FONT}"
sleep 2
fi
}      
clear
    function check_os_version() {
    local os_id os_version

    os_id=$(grep -w ID /etc/os-release | cut -d= -f2 | tr -d '"')
    os_version=$(grep -w VERSION_ID /etc/os-release | cut -d= -f2 | tr -d '"')

    case "$os_id" in
        ubuntu)
            case "$os_version" in
                22.04|24.04|26.04)
                    print_ok "OS Supported: Ubuntu $os_version"
                    ;;
                *)
                    print_error "Ubuntu $os_version is not supported."
                    exit 1
                    ;;
            esac
            ;;
        debian)
            case "$os_version" in
                11|12|13)
                    print_ok "OS Supported: Debian $os_version"
                    ;;
                *)
                    print_error "Debian $os_version is not supported."
                    exit 1
                    ;;
            esac
            ;;
        *)
            print_error "OS ($os_id $os_version) is not supported."
            exit 1
            ;;
    esac
}

if [[ $(uname -m) == "x86_64" ]]; then
    print_ok "Architecture Supported: $(uname -m)"
else
    print_error "Architecture Not Supported: $(uname -m)"
    exit 1
fi

# Cek versi OS
check_os_version

if [ "${EUID}" -ne 0 ]; then
   print_error "You need to run this script as root"
   exit 1
fi
if [ "$(systemd-detect-virt)" == "openvz" ]; then
   print_error "OpenVZ is not supported"
   exit 1
fi
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates curl wget git jq at cron bash-completion \
    dos2unix python3 python3-pip python3-venv python-is-python3 socat netcat-openbsd \
    iputils-ping bzip2 gzip xz-utils zip unzip p7zip-full pwgen \
    openssl sudo lsof htop procps util-linux build-essential \
    gcc g++ make cmake pkg-config libssl-dev libsqlite3-dev \
    libnss3-dev libnspr4-dev libpam0g-dev libcap-ng-dev \
    libcap-ng-utils libselinux1-dev libcurl4-nss-dev libevent-dev \
    flex bison bc rsyslog sed dirmngr libxml-parser-perl \
    msmtp-mta bsd-mailx iptables iptables-persistent \
    netfilter-persistent net-tools gnupg lsb-release dnsutils \
    openvpn easy-rsa chrony vnstat speedtest-cli wondershaper \
    ruby ruby-dev figlet nginx

gem install lolcat --no-document || print_ok "lolcat gem tidak tersedia; lanjut tanpa lolcat."

print_install "Menambahkan Data Izin Akses Script"
rm -f ./fix-izin.sh
wget -O fix-izin.sh https://raw.githubusercontent.com/ajijainalganteng-wq/v4/main/fix-izin.sh
chmod 700 fix-izin.sh
./fix-izin.sh

# Clear the terminal
clear
echo -e "\e[32mloading...\e[0m"
clear
REPO="https://raw.githubusercontent.com/arivpnstores/v4/main/"
start=$(date +%s)
secs_to_human() {
echo "Installation time : $((${1} / 3600)) hours $(((${1} / 60) % 60)) minute's $((${1} % 60)) seconds"
}
function is_root() {
if [[ 0 == "$UID" ]]; then
print_ok "Root user Start installation process"
else
print_error "The current user is not the root user, please switch to the root user and run the script again"
fi
}
clear
print_install "Membuat direktori xray"
mkdir -p /etc/xray
curl -4fsS --max-time 10 https://ifconfig.me > /etc/xray/ipvps
mkdir -p /var/log/xray
chown www-data:www-data /var/log/xray
chmod 755 /var/log/xray
touch /var/log/xray/access.log
touch /var/log/xray/error.log
mkdir -p /var/lib/kyt >/dev/null 2>&1
while IFS=":" read -r a b; do
case $a in
"MemTotal") ((mem_used+=${b/kB})); mem_total="${b/kB}" ;;
"Shmem") ((mem_used+=${b/kB}))  ;;
"MemFree" | "Buffers" | "Cached" | "SReclaimable")
mem_used="$((mem_used-=${b/kB}))"
;;
esac
done < /proc/meminfo
Ram_Usage="$((mem_used / 1024))"
Ram_Total="$((mem_total / 1024))"
export tanggal=`date -d "0 days" +"%d-%m-%Y - %X" `
export OS_Name=$( cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/PRETTY_NAME//g' | sed 's/=//g' | sed 's/"//g' )
export Kernel=$( uname -r )
export Arch=$( uname -m )
export IP=$( curl -4fsS --max-time 10 https://ipinfo.io/ip/ )
function first_setup() {
    timedatectl set-timezone Asia/Jakarta || true
    print_ok "Memasang HAProxy dari repository distro..."
    apt-get update
    apt-get install -y haproxy
    systemctl enable haproxy
    print_success "HAProxy Installation"
    print_ok "first_setup SELESAI"
}

