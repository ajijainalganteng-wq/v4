# =========================================================
# RESTART + CHECK OPENVPN
# =========================================================

function restart_ovpn() {

    echo ""
    echo "========== OPENVPN RESTART =========="

    SERVICES=(
        openvpn-server@server-tcp
        openvpn-server@server-udp
    )

    systemctl daemon-reload

    for SERVICE in "${SERVICES[@]}"; do

        echo ""
        echo "[OpenVPN] Restart $SERVICE ..."

        systemctl enable "$SERVICE" || {
            echo "[ERROR] Gagal mengaktifkan $SERVICE"
            return 1
        }

        if ! systemctl restart "$SERVICE"; then
            echo "[ERROR] Restart $SERVICE gagal!"
            journalctl -u "$SERVICE" -n 40 --no-pager
            return 1
        fi

        # Tunggu service benar-benar aktif
        RUNNING=0

        for i in $(seq 1 15); do
            if systemctl is-active --quiet "$SERVICE"; then
                RUNNING=1
                break
            fi
            sleep 1
        done

        if [ "$RUNNING" -eq 1 ]; then
            echo "[OK] $SERVICE RUNNING"
        else
            echo "[ERROR] $SERVICE GAGAL RUNNING!"
            systemctl status "$SERVICE" --no-pager -l || true
            journalctl -u "$SERVICE" -n 40 --no-pager
            return 1
        fi
    done

    echo ""
    echo "========== OPENVPN STATUS =========="

    systemctl --no-pager --full status \
        openvpn-server@server-tcp \
        openvpn-server@server-udp

    echo ""
    echo "========== OPENVPN PORT =========="

    ss -tulpn | grep -E ':(1194|2200|443)\b' || true

    echo ""
    echo "[SUCCESS] Seluruh service OpenVPN aktif."
}

# =========================================================
# MAIN INSTALLATION
# =========================================================

function install_ovpn() {

    echo ""
    echo "===================================="
    echo "       INSTALL OPENVPN SERVER"
    echo "===================================="

    ovpn_install

    config_easy

    make_follow

    cert_ovpn

    restart_ovpn

    echo ""
    echo "[SUCCESS] Instalasi OpenVPN selesai."
}

install_ovpn
