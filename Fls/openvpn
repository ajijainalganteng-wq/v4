function install_ovpn() {

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: Jalankan script sebagai root."
    exit 1
fi

ovpn_install
config_easy
make_follow
cert_ovpn

# Mengaktifkan NAT untuk koneksi VPN
WAN_IF=$(ip -4 route get 1.1.1.1 2>/dev/null | \
awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')

if [ -n "$WAN_IF" ]; then

    iptables -C FORWARD -i tun+ -o "$WAN_IF" -j ACCEPT 2>/dev/null || \
    iptables -I FORWARD -i tun+ -o "$WAN_IF" -j ACCEPT

    iptables -C FORWARD -i "$WAN_IF" -o tun+ \
    -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
    iptables -I FORWARD -i "$WAN_IF" -o tun+ \
    -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

    iptables -t nat -C POSTROUTING -s 10.6.0.0/24 -o "$WAN_IF" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -s 10.6.0.0/24 -o "$WAN_IF" -j MASQUERADE

    iptables -t nat -C POSTROUTING -s 10.7.0.0/24 -o "$WAN_IF" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -s 10.7.0.0/24 -o "$WAN_IF" -j MASQUERADE

    netfilter-persistent save

else
    echo "PERINGATAN: Interface jaringan tidak ditemukan."
fi

# Mengaktifkan service OpenVPN
systemctl daemon-reload

systemctl enable openvpn-server@server-tcp
systemctl enable openvpn-server@server-udp

systemctl restart openvpn-server@server-tcp
systemctl restart openvpn-server@server-udp

# Pemeriksaan service
echo "===== OPENVPN TCP ====="
systemctl status openvpn-server@server-tcp --no-pager -l || true

echo "===== OPENVPN UDP ====="
systemctl status openvpn-server@server-udp --no-pager -l || true

if ! systemctl is-active --quiet openvpn-server@server-tcp || \
   ! systemctl is-active --quiet openvpn-server@server-udp; then

    echo "ERROR: OpenVPN belum berjalan sempurna."
    journalctl -u openvpn-server@server-tcp \
    -u openvpn-server@server-udp -n 80 --no-pager

    exit 1
fi

echo "======================================"
echo " OPENVPN BERHASIL DIPASANG "
echo "======================================"
echo "Endpoint : $VPN_ENDPOINT"
echo "TCP      : 1194"
echo "UDP      : 2200"
echo "CA       : $SERVER_DIR/ca.crt"
echo "Backup   : $BACKUP"
echo "======================================"

}

install_ovpn
