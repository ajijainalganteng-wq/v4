    FILE="/etc/openvpn/${CONFIG}.ovpn"

    if [ ! -s "$FILE" ]; then
        echo "ERROR: File $FILE tidak ditemukan."
        exit 1
    fi

    cat >> "$FILE" <<EOF

<ca>
$(cat "$SERVER_DIR/ca.crt")
</ca>
EOF

    cp "$FILE" "/var/www/html/${CONFIG}.ovpn"

done

# Membuat ZIP konfigurasi
cd /var/www/html/

rm -f Kyt-Project.zip

