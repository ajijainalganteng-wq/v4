#!/bin/bash

export DEBIAN_FRONTEND=noninteractive

domain=$(tr -d '[:space:]' < /root/domain 2>/dev/null)

if [ -z "$domain" ]; then
    echo "ERROR: Domain tidak ditemukan di /root/domain."
    exit 1
fi

if ! command -v openvpn >/dev/null 2>&1; then
    echo "ERROR: OpenVPN belum terinstal."
    exit 1
fi

for cmd in wget unzip zip curl systemctl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "ERROR: Perintah $cmd belum tersedia."
        exit 1
    fi
done

# --- Compat OpenVPN ---
for _compat_candidate in "$(dirname "$0")/universal_compat.sh" "./universal_compat.sh" "/tmp/universal_compat.sh"; do
    if [ -f "$_compat_candidate" ]; then
        . "$_compat_candidate" >/dev/null 2>&1 || true
        break
    fi
done

if ! command -v compat_openvpn_unit >/dev/null 2>&1; then
    compat_openvpn_unit() {
        local inst="$1"

        if [ -f /lib/systemd/system/openvpn-server@.service ] || [ -f /etc/systemd/system/openvpn-server@.service ]; then
            echo "openvpn-server@${inst}"
        else
            echo "openvpn@${inst}"
        fi
    }
fi

OVPN_TCP_UNIT=$(compat_openvpn_unit server-tcp)
OVPN_UDP_UNIT=$(compat_openvpn_unit server-udp)

function ovpn_compat_config() {
    local ver major_minor conf

    ver=$(openvpn --version 2>/dev/null | awk 'NR==1 {print $2}')
    [ -n "$ver" ] || return 1

    major_minor=$(echo "$ver" | cut -d. -f1-2)

    if [ "$(printf '%s\n%s\n' "2.5" "$major_minor" | sort -V | head -n1)" = "2.5" ]; then
        echo "OpenVPN $ver terdeteksi (>= 2.5)."
        return 0
    fi

    echo "OpenVPN $ver terdeteksi (< 2.5). Menyesuaikan cipher..."

    for conf in /etc/openvpn/server/server-tcp.conf /etc/openvpn/server/server-udp.conf; do
        [ -f "$conf" ] || continue

        sed -i '/^[[:space:]]*data-ciphers\(-fallback\)\?[[:space:]]/d' "$conf"

        if ! grep -q '^[[:space:]]*cipher[[:space:]]' "$conf"; then
            sed -i '1i cipher AES-256-GCM' "$conf"
        fi
    done
}

function ovpn_legacy_layout() {
    case "$OVPN_TCP_UNIT" in
        openvpn@*) ;;
        *) return 0 ;;
    esac

    echo "Menyiapkan layout OpenVPN lama..."

    local f name

    for f in ca.crt server.crt server.key dh2048.pem crl.pem tc.key ipp.txt; do
        if [ -e "/etc/openvpn/server/$f" ]; then
            ln -sf "/etc/openvpn/server/$f" "/etc/openvpn/$f"
        fi
    done

    for name in server-tcp server-udp; do
        if [ -f "/etc/openvpn/server/$name.conf" ]; then
            cp "/etc/openvpn/server/$name.conf" "/etc/openvpn/$name.conf"
        fi
    done
}

function ovpn_install() {
    echo "Menginstal dan mengekstrak konfigurasi OpenVPN..."

    local tmp_dir

    tmp_dir=$(mktemp -d) || {
        echo "ERROR: Gagal membuat direktori sementara."
        return 1
    }

    if ! wget -q -O "$tmp_dir/vpn.zip" "https://raw.githubusercontent.com/ajijainalganteng-wq/WendyVpn/refs/heads/main/ovpn/vpn.zip"; then
        echo "ERROR: Gagal mengunduh konfigurasi OpenVPN."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! unzip -tq "$tmp_dir/vpn.zip" >/dev/null 2>&1; then
        echo "ERROR: File ZIP rusak atau tidak valid."
        rm -rf "$tmp_dir"
        return 1
    fi

    if ! unzip -q "$tmp_dir/vpn.zip" -d "$tmp_dir/extract"; then
        echo "ERROR: Gagal mengekstrak konfigurasi."
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -f "$tmp_dir/extract/server/server-tcp.conf" ] ||
       [ ! -f "$tmp_dir/extract/server/server-udp.conf" ] ||
       [ ! -f "$tmp_dir/extract/server/ca.crt" ]; then
        echo "ERROR: File konfigurasi server atau CA tidak lengkap."
        rm -rf "$tmp_dir"
        return 1
    fi

    mkdir -p /etc/openvpn

    cp -a "$tmp_dir/extract/." /etc/openvpn/ || {
        echo "ERROR: Gagal memasang konfigurasi OpenVPN."
        rm -rf "$tmp_dir"
        return 1
    }

    rm -rf "$tmp_dir"

    ovpn_compat_config || return 1
    ovpn_legacy_layout || return 1

    if [ -d "/etc/openvpn/server/easy-rsa/" ]; then
        chown -R root:root /etc/openvpn/server/easy-rsa/
    fi

    echo "Instalasi konfigurasi OpenVPN selesai."
}

function config_easy() {
    echo "Mengkonfigurasi OpenVPN..."

    mkdir -p /usr/lib/openvpn/

    local ARCH_LIB PLUGIN_SOURCE PLUGIN_DEST

    ARCH_LIB=$(uname -m | sed 's/x86_64/x86_64-linux-gnu/;s/aarch64/aarch64-linux-gnu/;s/armv7l/arm-linux-gnueabihf/')

    PLUGIN_SOURCE="/usr/lib/${ARCH_LIB}/openvpn/plugins/openvpn-plugin-auth-pam.so"
    PLUGIN_DEST="/usr/lib/openvpn/openvpn-plugin-auth-pam.so"

    if [ -f "$PLUGIN_SOURCE" ]; then
        cp "$PLUGIN_SOURCE" "$PLUGIN_DEST"
        chmod 755 "$PLUGIN_DEST"
        echo "Plugin PAM berhasil disiapkan."
    else
        echo "Peringatan: Plugin PAM tidak ditemukan."
    fi

    chmod 755 /usr/lib/openvpn/

    systemctl daemon-reload

    if [ "$OVPN_TCP_UNIT" = "$OVPN_UDP_UNIT" ]; then
        echo "ERROR: Unit TCP dan UDP tidak boleh sama."
        return 1
    fi

    echo "Mengaktifkan layanan $OVPN_TCP_UNIT..."
    systemctl enable --now "$OVPN_TCP_UNIT" || echo "Peringatan: Gagal menjalankan $OVPN_TCP_UNIT"

    echo "Mengaktifkan layanan $OVPN_UDP_UNIT..."
    systemctl enable --now "$OVPN_UDP_UNIT" || echo "Peringatan: Gagal menjalankan $OVPN_UDP_UNIT"

    echo "Konfigurasi OpenVPN selesai."
}

function make_follow() {
    echo "Mengkonfigurasi IP forwarding dan file .ovpn..."

    sysctl -w net.ipv4.ip_forward=1 >/dev/null

    mkdir -p /etc/sysctl.d/

    echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-openvpn-forward.conf

    sysctl --system >/dev/null 2>&1

    echo "IP forwarding diaktifkan."

    cat > /etc/openvpn/tcp.ovpn <<-END
client
dev tun
proto tcp
remote $domain 1194
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    cat > /etc/openvpn/udp.ovpn <<-END
client
dev tun
proto udp
remote $domain 2200
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    cat > /etc/openvpn/ws-ssl.ovpn <<-END
client
dev tun
proto tcp
remote $domain 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    cat > /etc/openvpn/ssl.ovpn <<-END
client
dev tun
proto tcp
remote $domain 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    echo "File konfigurasi client (.ovpn) dibuat."
}

