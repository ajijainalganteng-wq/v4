    fi

    sed -i "s|IP-ADDRESSS|$PUBLIC_IP|g" /var/www/html/index.html

    cd - >/dev/null 2>&1

    echo "File konfigurasi, arsip ZIP, dan halaman download berhasil dibuat."
}

function install_ovpn() {
    echo "========== MENJALANKAN install_ovpn =========="

    ovpn_install || return 1
    config_easy || return 1
    make_follow || return 1
    cert_ovpn || return 1

    echo "========== install_ovpn SELESAI =========="
}

# Jalankan fungsi utama
install_ovpn
