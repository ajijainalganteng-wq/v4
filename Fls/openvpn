#!/bin/bash

export DEBIAN_FRONTEND=noninteractive

# Link Hosting
REPO="https://raw.githubusercontent.com/ajijainalganteng-wq/v4/main/"

# Deteksi IP dan interface jaringan
PUBLIC_IP=$(curl -4 -fsS https://api.ipify.org) || exit 1
DOMAIN=$(cat /root/domain 2>/dev/null | tr -d '[:space:]')
REMOTE_HOST="${DOMAIN:-$PUBLIC_IP}"
ANU=$(ip -4 route show default | awk 'NR==1 {print $5}')

if [ -z "$ANU" ]; then
    echo "ERROR: Interface jaringan tidak ditemukan."
    exit 1
fi

# Instal OpenVPN dan dependensi
apt-get update
apt-get install -y openvpn easy-rsa unzip openssl iptables iptables-persistent curl wget zip

if ! command -v openvpn >/dev/null 2>&1; then
    echo "ERROR: Instalasi OpenVPN gagal."
    exit 1
fi

# Deteksi service OpenVPN
for _compat_candidate in "$(dirname "$0")/universal_compat.sh" "./universal_compat.sh" "/tmp/universal_compat.sh"; do
    if [ -f "$_compat_candidate" ]; then
        . "$_compat_candidate" >/dev/null 2>&1 || true
        break
    fi
done

if ! command -v compat_openvpn_unit >/dev/null 2>&1; then
    compat_openvpn_unit() {
        local inst="$1"

        if [ -f /lib/systemd/system/openvpn-server@.service ] || [ -f /etc/systemd/system/openvpn-server@.service ]; then
            echo "openvpn-server@${inst}"
        else
            echo "openvpn@${inst}"
        fi
    }
fi

OVPN_TCP_UNIT=$(compat_openvpn_unit server-tcp)
OVPN_UDP_UNIT=$(compat_openvpn_unit server-udp)

# Ekstrak konfigurasi OpenVPN
echo "Mengunduh konfigurasi OpenVPN..."

TMP_DIR=$(mktemp -d) || exit 1

if ! wget -q -O "$TMP_DIR/vpn.zip" "${REPO}install/vpn.zip"; then
    echo "ERROR: Gagal mengunduh vpn.zip."
    rm -rf "$TMP_DIR"
    exit 1
fi

if ! unzip -tq "$TMP_DIR/vpn.zip" >/dev/null 2>&1; then
    echo "ERROR: File vpn.zip tidak valid."
    rm -rf "$TMP_DIR"
    exit 1
fi

mkdir -p /etc/openvpn

if ! unzip -oq "$TMP_DIR/vpn.zip" -d /etc/openvpn/; then
    echo "ERROR: Gagal mengekstrak vpn.zip."
    rm -rf "$TMP_DIR"
    exit 1
fi

rm -rf "$TMP_DIR"

mkdir -p /etc/openvpn/server/easy-rsa/
chown -R root:root /etc/openvpn/server/easy-rsa/

# Penyesuaian konfigurasi cipher
function ovpn_compat_config() {
    local ver major_minor conf

    ver=$(openvpn --version 2>/dev/null | awk 'NR==1 {print $2}')
    [ -n "$ver" ] || return 1

    major_minor=$(echo "$ver" | cut -d. -f1-2)

    if [ "$(printf '%s\n%s\n' "2.5" "$major_minor" | sort -V | head -n1)" = "2.5" ]; then
        echo "OpenVPN $ver: menggunakan data-ciphers."
        return 0
    fi

    echo "OpenVPN $ver: menyesuaikan cipher versi lama..."

    for conf in /etc/openvpn/server/server-tcp.conf /etc/openvpn/server/server-udp.conf; do
        [ -f "$conf" ] || continue

        sed -i '/^[[:space:]]*data-ciphers\(-fallback\)\?[[:space:]]/d' "$conf"

        if ! grep -q '^[[:space:]]*cipher[[:space:]]' "$conf"; then
            sed -i '1i cipher AES-256-GCM' "$conf"
        fi
    done
}

# Penyesuaian layout Debian lama
function ovpn_legacy_layout() {
    case "$OVPN_TCP_UNIT" in
        openvpn@*) ;;
        *) return 0 ;;
    esac

    local f name

    for f in ca.crt server.crt server.key dh2048.pem crl.pem tc.key ipp.txt; do
        if [ -e "/etc/openvpn/server/$f" ]; then
            ln -sf "/etc/openvpn/server/$f" "/etc/openvpn/$f"
        fi
    done

    for name in server-tcp server-udp; do
        if [ -f "/etc/openvpn/server/$name.conf" ]; then
            cp "/etc/openvpn/server/$name.conf" "/etc/openvpn/$name.conf"
        fi
    done
}

ovpn_compat_config || exit 1
ovpn_legacy_layout || exit 1

# Instalasi plugin PAM
mkdir -p /usr/lib/openvpn/

PLUGIN_SOURCE=$(find /usr/lib -type f -name openvpn-plugin-auth-pam.so 2>/dev/null | head -n1)
PLUGIN_DEST="/usr/lib/openvpn/openvpn-plugin-auth-pam.so"

if [ -n "$PLUGIN_SOURCE" ]; then
    cp "$PLUGIN_SOURCE" "$PLUGIN_DEST"
    chmod 755 "$PLUGIN_DEST"
    echo "Plugin PAM berhasil dipasang."
else
    echo "PERINGATAN: Plugin PAM tidak ditemukan."
fi

chmod 755 /usr/lib/openvpn/

# Aktifkan service OpenVPN
systemctl daemon-reload

echo "Mengaktifkan OpenVPN TCP..."
systemctl enable --now "$OVPN_TCP_UNIT" || {
    echo "ERROR: Gagal menjalankan $OVPN_TCP_UNIT."
    exit 1
}

echo "Mengaktifkan OpenVPN UDP..."
systemctl enable --now "$OVPN_UDP_UNIT" || {
    echo "ERROR: Gagal menjalankan $OVPN_UDP_UNIT."
    exit 1
}

# Aktifkan IP forwarding
sysctl -w net.ipv4.ip_forward=1

mkdir -p /etc/sysctl.d/
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-openvpn-forward.conf

# Buat konfigurasi client TCP 1194
cat > /etc/openvpn/tcp.ovpn <<-END
client
dev tun
proto tcp
remote $REMOTE_HOST 1194
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

# Buat konfigurasi client UDP 2200
cat > /etc/openvpn/udp.ovpn <<-END
client
dev tun
proto udp
remote $REMOTE_HOST 2200
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

# Buat konfigurasi client SSL 443
cat > /etc/openvpn/ssl.ovpn <<-END
client
dev tun
proto tcp
remote $REMOTE_HOST 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

# Tambahkan sertifikat CA
CA_FILE="/etc/openvpn/server/ca.crt"

if [ ! -f "$CA_FILE" ]; then
    echo "ERROR: Sertifikat CA tidak ditemukan."
    exit 1
fi

mkdir -p /home/vps/public_html/

for name in tcp udp ssl; do
    {
        echo '<ca>'
        cat "$CA_FILE"
        echo '</ca>'
    } >> "/etc/openvpn/$name.ovpn" || exit 1

    cp "/etc/openvpn/$name.ovpn" "/home/vps/public_html/$name.ovpn" || exit 1
done

# Firewall NAT
echo "Mengkonfigurasi firewall OpenVPN..."

for subnet in 10.6.0.0/24 10.7.0.0/24; do
    iptables -t nat -C POSTROUTING -s "$subnet" -o "$ANU" -j MASQUERADE 2>/dev/null ||
    iptables -t nat -A POSTROUTING -s "$subnet" -o "$ANU" -j MASQUERADE
done

# Simpan aturan firewall
mkdir -p /etc/iptables/
iptables-save > /etc/iptables/rules.v4

netfilter-persistent save
netfilter-persistent reload

# Periksa status OpenVPN
echo "Memeriksa status OpenVPN..."

systemctl is-active "$OVPN_TCP_UNIT"
systemctl is-active "$OVPN_UDP_UNIT"

echo "=========================================="
echo "INSTALASI OPENVPN SELESAI"
echo "=========================================="
echo "TCP     : $REMOTE_HOST:1194"
echo "UDP     : $REMOTE_HOST:2200"
echo "SSL     : $REMOTE_HOST:443"
echo "Download: /home/vps/public_html/"
echo "=========================================="
