function ovpn_install() {
rm -rf /etc/openvpn
mkdir -p /etc/openvpn
wget -O /etc/openvpn/vpn.zip "https://raw.githubusercontent.com/arivpnstores/v4/main/Vpn/vpn.zip" >/dev/null 2>&1
unzip -d /etc/openvpn/ /etc/openvpn/vpn.zip
rm -f /etc/openvpn/vpn.zip
chown -R root:root /etc/openvpn/server/easy-rsa/
}

function config_easy() {
    print_install "Configuring OpenVPN TCP & UDP"

    # Pastikan paket OpenVPN terpasang
    if ! command -v openvpn >/dev/null 2>&1; then
        apt-get update || return 1
        apt-get install -y openvpn || return 1
    fi

    # Pastikan konfigurasi dan sertifikat tersedia
    for file in \
        server-tcp.conf \
        server-udp.conf \
        ca.crt \
        server.crt \
        server.key \
        dh2048.pem
    do
        if [ ! -s "/etc/openvpn/server/$file" ]; then
            echo "[ERROR] File tidak ditemukan: $file"
            return 1
        fi
    done

    # Pastikan plugin PAM tersedia
    if [ ! -e /usr/lib/openvpn/openvpn-plugin-auth-pam.so ]; then
        echo "[ERROR] Plugin PAM tidak ditemukan"
        return 1
    fi

    # Amankan private key
    chmod 600 /etc/openvpn/server/server.key
    chmod 600 /etc/openvpn/server/ca.key 2>/dev/null || true

    # Aktifkan IP forwarding
    cat > /etc/sysctl.d/99-openvpn-forward.conf <<'EOF'
net.ipv4.ip_forward=1
EOF
    sysctl --system >/dev/null || return 1

    # Aktifkan service OpenVPN yang benar
    systemctl daemon-reload

    systemctl enable --now openvpn-server@server-tcp || return 1
    systemctl enable --now openvpn-server@server-udp || return 1

    # Verifikasi service
    systemctl is-active --quiet openvpn-server@server-tcp || return 1
    systemctl is-active --quiet openvpn-server@server-udp || return 1

    print_success "OpenVPN TCP & UDP berhasil dikonfigurasi"
}
