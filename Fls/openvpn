#!/bin/bash

set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

OS=$(uname -m)
MYIP=$(wget -qO- https://ipinfo.io/ip || true)

domain=$(cat /root/domain 2>/dev/null || true)

MYIP2="s/xxxxxxxxx/$domain/g"

# =========================================================
# INSTALL OPENVPN
# =========================================================

function ovpn_install() {

    echo "[OpenVPN] Memeriksa dependensi..."

    apt-get update -y

    apt-get install -y \
        openvpn \
        unzip \
        zip \
        wget \
        curl \
        ca-certificates

    echo "[OpenVPN] Mengunduh konfigurasi server..."

    TMP_ZIP=$(mktemp)
    TMP_DIR=$(mktemp -d)

    if ! wget -q \
        -O "$TMP_ZIP" \
        "https://raw.githubusercontent.com/ajijainalganteng-wq/v4/main/Vpn/vpn.zip"; then

        echo "[ERROR] Gagal mengunduh vpn.zip!"
        rm -rf "$TMP_ZIP" "$TMP_DIR"
        return 1
    fi

    if ! unzip -tq "$TMP_ZIP" >/dev/null 2>&1; then
        echo "[ERROR] File vpn.zip rusak atau tidak valid!"
        rm -rf "$TMP_ZIP" "$TMP_DIR"
        return 1
    fi

    echo "[OpenVPN] Mengekstrak konfigurasi..."

    if ! unzip -oq "$TMP_ZIP" -d "$TMP_DIR"; then
        echo "[ERROR] Gagal mengekstrak konfigurasi!"
        rm -rf "$TMP_ZIP" "$TMP_DIR"
        return 1
    fi

    # Pastikan konfigurasi TCP dan UDP tersedia
    if [ ! -f "$TMP_DIR/server/server-tcp.conf" ] ||
       [ ! -f "$TMP_DIR/server/server-udp.conf" ]; then

        echo "[ERROR] Konfigurasi server-tcp.conf atau server-udp.conf tidak ditemukan!"
        echo "Isi ZIP:"
        find "$TMP_DIR" -maxdepth 4 -type f
        rm -rf "$TMP_ZIP" "$TMP_DIR"
        return 1
    fi

    # Backup konfigurasi sebelumnya
    if [ -d /etc/openvpn ]; then
        BACKUP="/etc/openvpn.backup_$(date +%Y%m%d_%H%M%S)"
        mv /etc/openvpn "$BACKUP"
        echo "[OpenVPN] Backup konfigurasi lama: $BACKUP"
    fi

    mkdir -p /etc/openvpn

    if ! cp -a "$TMP_DIR"/. /etc/openvpn/; then
        echo "[ERROR] Gagal memasang konfigurasi!"

        rm -rf /etc/openvpn

        if [ -n "${BACKUP:-}" ] && [ -d "$BACKUP" ]; then
            mv "$BACKUP" /etc/openvpn
        fi

        rm -rf "$TMP_ZIP" "$TMP_DIR"
        return 1
    fi

    rm -rf "$TMP_ZIP" "$TMP_DIR"

    # Pastikan direktori Easy-RSA tersedia
    if [ -d /etc/openvpn/server/easy-rsa ]; then
        chown -R root:root /etc/openvpn/server/easy-rsa/
    fi

    echo "[OpenVPN] Konfigurasi berhasil dipasang."
}

# =========================================================
# CONFIGURATION EASY + SYSTEMD
# =========================================================

function config_easy() {

    echo "[OpenVPN] Menyiapkan plugin PAM..."

    mkdir -p /usr/lib/openvpn

    PAM_SOURCE=""

    for FILE in \
        /usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so \
        /usr/lib/openvpn/plugins/openvpn-plugin-auth-pam.so \
        /usr/lib/aarch64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so
    do
        if [ -f "$FILE" ]; then
            PAM_SOURCE="$FILE"
            break
        fi
    done

    if [ -n "$PAM_SOURCE" ]; then
        install -m 0755 "$PAM_SOURCE" \
            /usr/lib/openvpn/openvpn-plugin-auth-pam.so
    fi

    # Periksa apakah konfigurasi membutuhkan plugin PAM
    if grep -RqsE '^[[:space:]]*plugin[[:space:]]+' \
        /etc/openvpn/server/server-tcp.conf \
        /etc/openvpn/server/server-udp.conf; then

        if [ ! -f /usr/lib/openvpn/openvpn-plugin-auth-pam.so ]; then
            echo "[ERROR] Plugin OpenVPN PAM tidak ditemukan!"
            return 1
        fi
    fi

    echo "[OpenVPN] Memeriksa systemd template..."

    if ! systemctl cat openvpn-server@.service >/dev/null 2>&1; then
        echo "[ERROR] Unit openvpn-server@.service tidak tersedia!"
        return 1
    fi

    systemctl daemon-reload

    echo "[OpenVPN] Konfigurasi systemd siap."
}

# =========================================================
# IP FORWARD + CLIENT CONFIGURATION
# =========================================================

function make_follow() {

    echo "[OpenVPN] Mengaktifkan IP Forward..."

    echo 1 > /proc/sys/net/ipv4/ip_forward

    if ! grep -qE '^[[:space:]]*net.ipv4.ip_forward=1' /etc/sysctl.conf; then
        echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
    fi

    sysctl -w net.ipv4.ip_forward=1 >/dev/null

    # Validasi domain
    domain=$(cat /root/domain 2>/dev/null | tr -d '[:space:]')

    if [ -z "$domain" ]; then
        echo "[ERROR] Domain tidak ditemukan di /root/domain!"
        return 1
    fi

    if ! [[ "$domain" =~ ^[A-Za-z0-9.-]+$ ]]; then
        echo "[ERROR] Format domain tidak valid!"
        return 1
    fi

    # TCP
    cat > /etc/openvpn/tcp.ovpn <<END
client
dev tun
proto tcp
remote $domain 1194
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    # UDP
    cat > /etc/openvpn/udp.ovpn <<END
client
dev tun
proto udp
remote $domain 2200
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    # WS SSL
    cat > /etc/openvpn/ws-ssl.ovpn <<END
client
dev tun
proto tcp
remote $domain 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    # SSL
    cat > /etc/openvpn/ssl.ovpn <<END
client
dev tun
proto tcp
remote $domain 443
resolv-retry infinite
route-method exe
nobind
persist-key
persist-tun
auth-user-pass
comp-lzo
verb 3
END

    echo "[OpenVPN] Client configuration berhasil dibuat."
}

# =========================================================
